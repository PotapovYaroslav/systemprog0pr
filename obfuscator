import java.io.*;
import java.nio.file.Files;
import java.util.*;
import java.util.regex.*;

public class Main {

    private static final Set<String> KEYWORDS = new HashSet<>(Arrays.asList(
            "abstract", "assert", "boolean", "break", "byte", "case", "catch",
            "char", "class", "const", "continue", "default", "do", "double",
            "else", "enum", "extends", "final", "finally", "float", "for",
            "goto", "if", "implements", "import", "instanceof", "int",
            "interface", "long", "native", "new", "package", "private",
            "protected", "public", "return", "short", "static", "strictfp",
            "super", "switch", "synchronized", "this", "throw", "throws",
            "transient", "try", "void", "volatile", "while",
            "true", "false", "null", "var"
    ));

    private static final Set<String> SKIP = new HashSet<>(Arrays.asList(
            "System", "out", "in", "err", "println", "print", "printf",
            "main", "args",
            "String", "Integer", "Double", "Float", "Long", "Short", "Byte",
            "Boolean", "Character", "Object", "Math", "Scanner",
            "Exception", "RuntimeException", "Throwable", "Error",
            "List", "ArrayList", "Map", "HashMap", "Set", "HashSet",
            "Arrays", "Collections", "Override",
            "toString", "equals", "hashCode", "length", "size",
            "get", "put", "add", "remove", "valueOf",
            "parseInt", "parseDouble", "nextInt", "nextLine", "next",
            "StringBuilder", "StringBuffer", "Thread", "Runnable",
            "Comparable", "Iterator", "Random",
            "Files", "Paths", "IOException", "FileNotFoundException"
    ));

    public static void main(String[] args) throws IOException {
        if (args.length < 1) {
            System.out.println("Использование: java Obfuscator <путь к папке>");
            return;
        }

        File dir = new File(args[0]);
        File[] files = dir.listFiles((d, name) -> name.endsWith(".java"));

        if (files == null || files.length == 0) {
            System.out.println("В указанной папке не найдено файлов .java");
            return;
        }

        for (File f : files) {
            obfuscateFile(f);
        }
    }

    private static void obfuscateFile(File file) throws IOException {
        String code = new String(Files.readAllBytes(file.toPath()), "UTF-8");
        code = removeComments(code);

        String oldClassName = findClassName(code);
        if (oldClassName == null) {
            System.out.println("Не найден класс в файле " + file.getName() + " — пропускаем");
            return;
        }



        List<String> identifiers = findIdentifiers(code, oldClassName);


        Map<String, String> renameMap = generateNames(identifiers);


        String newClassName = "A";
        renameMap.put(oldClassName, newClassName);

        code = replaceIdentifiers(code, renameMap);


        code = compressWhitespace(code);


        File newFile = new File(file.getParentFile(), newClassName + ".java");
        try (Writer w = new OutputStreamWriter(new FileOutputStream(newFile), "UTF-8")) {
            w.write(code);
        }

        System.out.println("Готово: " + file.getName() + " -> " + newFile.getName());
    }

    private static String removeComments(String code) {
        StringBuilder sb = new StringBuilder();
        boolean inString = false;
        boolean inChar = false;
        boolean inLineComment = false;
        boolean inBlockComment = false;

        for (int i = 0; i < code.length(); i++) {
            char c = code.charAt(i);
            char next = (i + 1 < code.length()) ? code.charAt(i + 1) : '\0';

            if (inLineComment) {
                if (c == '\n') {
                    inLineComment = false;
                    sb.append(c);
                }
                continue;
            }

            if (inBlockComment) {
                if (c == '*' && next == '/') {
                    inBlockComment = false;
                    i++;
                }
                continue;
            }

            if (inString) {
                sb.append(c);
                if (c == '\\' && next != '\0') {
                    sb.append(next);
                    i++;
                    continue;
                }
                if (c == '"') {
                    inString = false;
                }
                continue;
            }

            if (inChar) {
                sb.append(c);
                if (c == '\\' && next != '\0') {
                    sb.append(next);
                    i++;
                    continue;
                }
                if (c == '\'') {
                    inChar = false;
                }
                continue;
            }

            if (c == '/' && next == '/') {
                inLineComment = true;
                i++;
                continue;
            }
            if (c == '/' && next == '*') {
                inBlockComment = true;
                i++;
                continue;
            }
            if (c == '"') {
                inString = true;
                sb.append(c);
                continue;
            }
            if (c == '\'') {
                inChar = true;
                sb.append(c);
                continue;
            }

            sb.append(c);
        }

        return sb.toString();
    }


    private static String findClassName(String code) {
        Matcher m = Pattern.compile("\\bclass\\s+([A-Za-z_][A-Za-z0-9_]*)").matcher(code);
        if (m.find()) {
            return m.group(1);
        }
        return null;
    }


    private static List<String> findIdentifiers(String code, String className) {

        Set<String> found = new LinkedHashSet<>();
        Matcher m = Pattern.compile("\\b[A-Za-z_][A-Za-z0-9_]*\\b").matcher(code);

        while (m.find()) {
            String word = m.group();
            if (KEYWORDS.contains(word)) continue;
            if (SKIP.contains(word)) continue;
            if (word.equals(className)) continue; // класс переименуем отдельно
            found.add(word);
        }

        return new ArrayList<>(found);
    }

    private static Map<String, String> generateNames(List<String> identifiers) {
        List<String> pool = buildNamePool(identifiers.size());
        Map<String, String> map = new LinkedHashMap<>();

        for (int i = 0; i < identifiers.size(); i++) {
            map.put(identifiers.get(i), pool.get(i));
        }

        return map;
    }

    private static List<String> buildNamePool(int count) {
        List<String> pool = new ArrayList<>();
        String letters = "abcdefghijklmnopqrstuvwxyz";

        for (char c : letters.toCharArray()) {
            String name = String.valueOf(c);
            if (!KEYWORDS.contains(name)) {
                pool.add(name);
            }
            if (pool.size() >= count) {
                return pool;
            }
        }

        for (char c1 : letters.toCharArray()) {
            for (char c2 : letters.toCharArray()) {
                String name = "" + c1 + c2;
                if (!KEYWORDS.contains(name)) {
                    pool.add(name);
                }
                if (pool.size() >= count) {
                    return pool;
                }
            }
        }

        return pool;
    }

    
    
    private static String replaceIdentifiers(String code, Map<String, String> renameMap) {
        for (Map.Entry<String, String> entry : renameMap.entrySet()) {
            String oldName = entry.getKey();
            String newName = entry.getValue();
            code = code.replaceAll("\\b" + Pattern.quote(oldName) + "\\b",
                    Matcher.quoteReplacement(newName));
        }
        return code;
    }
    private static String compressWhitespace(String code) {
        code = code.replaceAll("(?m)^[ \t]*\r?\n", "");   // убрать пустые строки
        code = code.replaceAll("(?m)^[ \t]+", "");        // убрать отступы в начале строк
        code = code.replaceAll("(?m)[ \t]+$", "");        // убрать пробелы в конце строк
        code = code.replaceAll("[ \t]{2,}", " ");          // схлопнуть повторяющиеся пробелы
        return code;
    }
}
